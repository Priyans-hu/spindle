<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_vinyl" />
            <!-- Night: 2dp cream 20% rim lifts the disc off the dark ground. -->
            <stroke android:width="2dp" android:color="@color/widget_analog_disc_rim" />
        </shape>
    </item>
    <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/widget_groove" />
        </shape>
    </item>
    <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/widget_groove" />
        </shape>
    </item>
    <!-- One soft gloss arc, so the turn reads while playing. -->
    <item>
        <shape
            android:innerRadiusRatio="3.3"
            android:shape="ring"
            android:thicknessRatio="5.6"
            android:useLevel="false">
            <gradient
                android:centerColor="#26FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="sweep"
                android:useLevel="false" />
        </shape>
    </item>
</layer-list>
