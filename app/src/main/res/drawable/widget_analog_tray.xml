<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Night: 1dp cream 10% top edge (transparent in Day). -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_analog_tray_edge" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_analog_tray" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
